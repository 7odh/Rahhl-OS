<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header with Add Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="قائمة المطلوب اليوم ☑️"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1B273F"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="+ إضافة"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#27354E" />

    <!-- Item 1 -->
    <TextView
        android:id="@+id/widget_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp"
        android:text="🟢 الصلاة (عادة • 5 صلوات)"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <!-- Item 2 -->
    <TextView
        android:id="@+id/widget_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp"
        android:text="🔵 دراسة English (مهمة • Busuu)"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <!-- Item 3 -->
    <TextView
        android:id="@+id/widget_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp"
        android:text="🟠 جلسة تركيز 25 دقيقة (Pomodoro)"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_item_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="3dp"
        android:text="🟢 قراءة القرآن (عادة • بعد الفجر)"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="المس لفتح تطبيق Achievement 🚀"
        android:textColor="#64748B"
        android:textSize="9sp" />
</LinearLayout>
